# Copy to .env for a local install. Replace every CHANGE_ME value.
# Never commit .env or put real credentials in this template.
NODE_ENV=production

# PostgreSQL application database; use a fresh database, not an existing one.
HME_DB_HOST=127.0.0.1
HME_DB_PORT=5432
HME_DB_NAME=gapura_dev
HME_DB_USER=gapura_dev
HME_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Local service endpoints and paths. Adjust checkout/private paths to this host.
PORT=3005
GAPURA_PUBLIC_ORIGIN=http://127.0.0.1:3005
RENDER_HOST=127.0.0.1
RENDER_PORT=3000
RENDER_SERVICE_URL=http://127.0.0.1:3000
DESIGN_SYSTEM_PATH=/opt/gapura/design-system
STORAGE_PATH=/var/lib/gapura/storage
EDITORIAL_PYTHON=/opt/gapura/.venv-editorial/bin/python
GAPURA_DISABLE_WORKERS=true

# Generate independent random values for the web signature and renderer auth.
GAPURA_ADMIN_TOKEN=CHANGE_ME_RANDOM_WEB_SIGNATURE_SECRET
RENDER_SECRET=CHANGE_ME_DIFFERENT_RANDOM_RENDER_SECRET
GAPURA_PROVIDER_SECRETS=/var/lib/gapura/provider-keys.json
GAPURA_META_CONNECTION=/var/lib/gapura/meta-unified.json

# Editorial research. Firecrawl is optional; public social/forum signals remain
# available without it, but full web/news search requires a key.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
OCRAWLER_BASE_URL=
X_BEARER_TOKEN=
RSSHUB_BASE_URL=

# Configure inference keys in /etc/gapura/provider-keys.json or environment.
# Keep all provider keys out of Git and dashboard payloads.
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Optional human-review delivery. No token means no Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

# Publisher remains non-live by default. Set up credentials/permissions
# separately; do not enable timers as part of initial installation.
META_PUBLISH_MODE=shadow
META_PLATFORMS=instagram,facebook
META_APP_ID=
META_APP_SECRET=
META_UNIFIED_CONFIG_ID=
META_UNIFIED_REDIRECT_URI=
META_UNIFIED_GRAPH_VERSION=v27.0
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_THREADS_USER_ID=
META_THREADS_ACCESS_TOKEN=
APP_BASE_URL=http://127.0.0.1:3005

# Bootstrap database migration guard. Leave disabled except on a new,
# dedicated gapura_* database after verifying HME_DB_NAME.
GAPURA_DB_ALLOW_INIT=no
